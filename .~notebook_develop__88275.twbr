          <datasource-dependencies datasource='federated.0g0xunp1lkxysq0zuvh6e0o5k6zt'>
            <column datatype='date' name='[Birthdate]' role='dimension' type='ordinal' />
            <column caption='% Total Hired' datatype='real' default-format='p0%' name='[Calculation1]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_583708796728922112] / TOTAL([Calculation_583708796728922112])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Sum' caption='Age' datatype='integer' name='[Calculation_3358137274673762310]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [Birthdate], TODAY())' />
            </column>
            <column caption='Age Groups ' datatype='string' name='[Calculation_4364691791713832960]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_3358137274673762310] &lt; 25 THEN &apos;&lt;25&apos; &#10;ELSEIF [Calculation_3358137274673762310] &gt;= 25 AND [Calculation_3358137274673762310] &lt; 35 THEN &apos;25-34&apos; &#10;ELSEIF [Calculation_3358137274673762310] &gt;= 35 AND [Calculation_3358137274673762310] &lt; 45 THEN &apos;35-44&apos; &#10;ELSEIF [Calculation_3358137274673762310] &gt;=45 AND [Calculation_3358137274673762310] &lt; 55 THEN &apos;45-54&apos; &#10;ELSEIF [Calculation_3358137274673762310] &gt;= 55 THEN &apos;55+&apos; &#10;END' />
            </column>
            <column caption='Total Hired' datatype='integer' name='[Calculation_583708796728922112]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Employee_ID])' />
            </column>
            <column caption='Location ' datatype='string' name='[Calculation_583708796804218885]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [State] &#10;    WHEN &apos;New York&apos; THEN &apos;HQ&apos; &#10;    ELSE &apos;Branch&apos; &#10;END' />
            </column>
            <column caption='Status' datatype='string' name='[Calculation_6519523476982894592]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#10;ISNULL([Termdate]) THEN &apos;Hired&apos; &#10;ELSE &apos;Terminated&apos; &#10;END' />
            </column>
            <column caption='Highlighted Max' datatype='boolean' name='[Calculation_6519523476997414913]' role='measure' type='nominal'>
              <calculation class='tableau' formula='WINDOW_MAX([Calculation_583708796728922112]) = [Calculation_583708796728922112]'>
