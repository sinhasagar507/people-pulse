          <zone forceUpdate='true' h='36750' hidden-by-user='true' id='251' type-v2='text' w='93500' x='6429' y='44875'>
            <formatted-text>
              <run fontalignment='1'>Æ&#10;</run>
              <run bold='true' fontalignment='1' fontcolor='#04c4a1'>Welcome</run>
              <run fontalignment='1' fontcolor='#ffffff'> &lt;Full Name&gt;</run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#04c4a1'>______________________________________________________________ </run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#04c4a1'>Hover</run>
              <run fontalignment='1' fontcolor='#ffffff'>Æ </run>
              <run fontalignment='1' fontcolor='#f5f5f5'>over the charts to see more information </run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#f5f5f5'>Click on the chart to</run>
              <run fontalignment='1' fontcolor='#ffffff'>Æ </run>
              <run fontalignment='1' fontcolor='#04c4a1'>filter</run>
              <run fontalignment='1' fontcolor='#ffffff'>Æ </run>
              <run fontalignment='1' fontcolor='#f5f5f5'>the entire dashboard</run>
              <run fontalignment='1' fontcolor='#ffffff'>Æ </run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#f5f5f5'>Click the switch icon on the top right corner to open the</run>
              <run fontalignment='1' fontcolor='#ffffff'>Æ </run>
              <run fontalignment='1' fontcolor='#04c4a1'>filter menu</run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#04c4a1'>______________________________________________________________ </run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#f5f5f5'>The HR dashboard uses a dataset generated using </run>
              <run fontalignment='1' fontcolor='#04c4a1'>ChatGPT </run>
              <run fontalignment='1' fontcolor='#f5f5f5'>and</run>
              <run fontalignment='1' fontcolor='#04c4a1'> Faker library </run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#04c4a1'>______________________________________________________________ </run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#04c4a1'>Author: </run>
              <run fontalignment='1' fontcolor='#f5f5f5'>Sagar Sinha</run>
              <run fontalignment='1' fontcolor='#04c4a1'>Æ </run>
              <run fontalignment='1'>Æ&#10;&#10;&#10;&#10;</run>
            </formatted-text>
